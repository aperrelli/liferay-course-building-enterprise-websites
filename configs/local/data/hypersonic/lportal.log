INSERT INTO FRAGMENTENTRYLINK VALUES(12,0,'350af0ac-26a1-09bc-0d2e-f1550a04561e','350af0ac-26a1-09bc-0d2e-f1550a04561e',60571,32106,16796623585306,32252,'Walter Douglas','2026-04-28 17:56:44.041000','2026-04-30 21:27:17.183000','092378e0-4f2b-42c3-1e1c-6d6d7b10f8a8',NULL,NULL,60536,20031,93,93,'.component-paragraph img {\u000a\u0009max-width: 100%;\u000a}','<div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text">\u000a\u0009<p>\u000a\u0009\u0009A paragraph is a self-contained unit of a discourse in writing dealing with\u000a\u0009\u0009a particular point or idea. Paragraphs are usually an expected part of\u000a\u0009\u0009formal writing, used to organize longer prose.\u000a\u0009</p>\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-text":{"collectionFieldId":"CPDefinitionSpecificationOptionValue_name","defaultValue":"\n\t<p>\n\t\tA paragraph is a self-contained unit of a discourse in writing dealing with\n\t\ta particular point or idea. Paragraphs are usually an expected part of\n\t\tformal writing, used to organize longer prose.\n\t<\/p>\n\n\n\n\n\n\n","config":{}}}}','hkie',0,'BASIC_COMPONENT-paragraph',1,'2026-04-30 20:45:14.832000',NULL)
