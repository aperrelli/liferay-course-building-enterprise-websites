INSERT INTO FRAGMENTENTRYLINK VALUES(83,0,'fd383cfb-2339-f505-85c5-bf47aa1a0752','fd383cfb-2339-f505-85c5-bf47aa1a0752',44489,32106,16796623585306,20122,'Clarity Admin','2024-08-12 17:01:31.000000','2026-04-30 20:45:14.583000','8635218a-92d0-6bae-f5f4-09d2f1cefb00','','',32391,20031,25,25,'.component-paragraph img {\u000a\u0009max-width: 100%;\u000a}','<div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text">\u000a\u0009<p>\u000a\u0009\u0009A paragraph is a self-contained unit of a discourse in writing dealing with\u000a\u0009\u0009a particular point or idea. Paragraphs are usually an expected part of\u000a\u0009\u0009formal writing, used to organize longer prose.\u000a\u0009</p>\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-text":{"collectionFieldId":"DDMStructure_RichText79978771","defaultValue":"\n\t<p>\n\t\tA paragraph is a self-contained unit of a discourse in writing dealing with\n\t\ta particular point or idea. Paragraphs are usually an expected part of\n\t\tformal writing, used to organize longer prose.\n\t<\/p>\n\n\n","config":{"mapperType":"link"}}}}','euzo',2,'BASIC_COMPONENT-paragraph',1,'2026-04-30 20:45:14.583000',NULL)
