INSERT INTO FRAGMENTENTRYLINK VALUES(28,0,'9c48f71f-d4ab-4044-ad8a-be506c39bc7d',45446,32106,16796623585306,20122,'Clarity Admin','2024-08-15 18:28:29.181000','2026-03-24 17:47:58.903000',0,0,32391,20031,26,26,'.component-html img {\u000a\u0009max-width: 100%;\u000a}','<div class="component-html" data-lfr-editable-id="element-html" data-lfr-editable-type="html">\u000a\u0009<h1>HTML Example</h1>\u000a\u000a\u0009<p class="mb-0">\u000a\u0009\u0009A paragraph is a <strong>self-contained</strong> unit of a discourse in\u000a\u0009\u0009writing dealing with a particular point or <em>idea</em>. Paragraphs are\u000a\u0009\u0009usually an expected part of formal writing, used to organize longer\u000a\u0009\u0009prose.\u000a\u0009</p>\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-html":{"config":{},"defaultValue":"\n\t<h1>HTML Example</h1>\n\n\t<p class=\"mb-0\">\n\t\tA paragraph is a <strong>self-contained</strong> unit of a discourse in\n\t\twriting dealing with a particular point or <em>idea</em>. Paragraphs are\n\t\tusually an expected part of formal writing, used to organize longer\n\t\tprose.\n\t</p>\n","className":"com.liferay.journal.model.JournalArticle","classNameId":"29208","classPK":"45263","classTypeId":"30514","itemSubtype":"Basic Web Content","itemType":"Web Content Article","title":"Our Story","fieldId":"DDMStructure_content"}}}','ffoo',0,'BASIC_COMPONENT-html',1,'2026-03-24 17:47:58.903000',NULL,'9c48f71f-d4ab-4044-ad8a-be506c39bc7d')
